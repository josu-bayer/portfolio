{
  "hosting": {
    "site": "josu-bayer",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(html|css|js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.woff2", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  }
}
